{
  "name": "ramp-exporter",
  "version": "0.1.0",
  "description": "Customer-run, open-source exporter for Ramp data into neutral files (raw-faithful JSONL bundles).",
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "ramp-exporter": "./src/cli.ts"
  },
  "scripts": {
    "start": "bun run src/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/cli.ts --compile --outfile dist/ramp-exporter"
  },
  "dependencies": {
    "yaml": "^2.5.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "bun-types": "^1.1.0",
    "typescript": "^5.5.4"
  }
}

# Copy to .env — KEEP OUT OF GIT. The exporter loads these at runtime.
# These are YOUR credentials and never leave the machine running the exporter.

# --- Ramp developer app (customer admin creates it: Settings -> Developer) ---
# Read-only app, Client Credentials grant.
RAMP_CLIENT_ID=
RAMP_CLIENT_SECRET=

# v1 writes to a LOCAL folder (output.backend: local), so no cloud/storage
# credentials are needed. Cloud bucket / SFTP destinations are a v2 concern.

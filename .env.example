# Copy to .env — KEEP OUT OF GIT. The exporter loads these at runtime.
# These are YOUR credentials and never leave the machine running the exporter.
# Fill in only the platform you're exporting from.

# --- Ramp: read-only developer app (Settings -> Developer), Client Credentials grant ---
RAMP_CLIENT_ID=
RAMP_CLIENT_SECRET=

# --- Mercury: read-only API token (Settings -> API Tokens) ---
MERCURY_API_TOKEN=

# --- Brex: user token with read access (Settings -> Developer) ---
BREX_API_TOKEN=

# --- Rho: API access token with every read scope (Settings -> Configurations -> Access Tokens) ---
RHO_API_TOKEN=

# v1 writes to a LOCAL folder (output.backend: local), so no cloud/storage
# credentials are needed. Cloud bucket / SFTP destinations are a v2 concern.
